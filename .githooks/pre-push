#!/bin/sh

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      printf '%s\n' 'main-এ সরাসরি push বন্ধ। নতুন branch push করে pull request দিন।' >&2
      exit 1
      ;;
    refs/tags/v*)
      case "$remote_sha" in
        *[!0]*)
          if [ "$local_sha" != "$remote_sha" ]; then
            printf '%s\n' 'আগের release tag বদলানো বা মোছা বন্ধ। নতুন সংস্করণের tag দিন।' >&2
            exit 1
          fi
          ;;
      esac
      ;;
  esac
done

exit 0
