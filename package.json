{
  "name": "bari-khata",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run release:check && tsc -b && node scripts/check-api-runtime.mjs && vite build",
    "release:check": "node scripts/check-release.mjs",
    "setup:hooks": "node scripts/setup-hooks.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --maxWorkers=4",
    "typecheck": "tsc -b",
    "db:start": "node scripts/start-local-backend.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "format": "prettier --write src scripts vite.config.ts README.md docs",
    "db:check": "node scripts/backend-check.mjs",
    "test:api-runtime": "node scripts/check-api-runtime.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@fontsource/hind-siliguri": "^5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@supabase/supabase-js": "^2.0.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.5",
    "vaul": "^1.1.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "supabase": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
