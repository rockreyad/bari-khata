{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/mcp-auth?document=resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp-auth?document=resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/mcp-auth?document=authorization"
    },
    {
      "source": "/api/mcp-auth/:action",
      "destination": "/api/mcp-auth?action=:action"
    },
    {
      "source": "/((?!api/|assets/|sw.js|workbox-|manifest.webmanifest|icon-|apple-touch-icon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/phone-login.ts": {
      "maxDuration": 30
    }
  }
}
