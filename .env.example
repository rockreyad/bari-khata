# Only VITE_ values reach the browser. Never prefix private keys or OTP with VITE_.
VITE_SUPABASE_URL=http://127.0.0.1:55431
VITE_SUPABASE_ANON_KEY=

# Server-only local phone auth: off | mock | sms. Fixed codes work only on localhost.
BARI_PHONE_AUTH_MODE=off
BARI_DEV_PHONE_OTP=
BARI_DEV_PHONE_AUTH_SECRET=
BARI_DEV_SUPABASE_SERVICE_ROLE_KEY=
