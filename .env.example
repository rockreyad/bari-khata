# শুধু VITE_ মান ব্রাউজারে যায়। গোপন কী বা OTP-এর নামে কখনও VITE_ যোগ করবেন না।
VITE_SUPABASE_URL=http://127.0.0.1:55431
VITE_SUPABASE_ANON_KEY=

# ফোন লগইনের পদ্ধতি: off | mock | manual | sms। mock শুধু localhost-এ চলে।
BARI_PHONE_AUTH_MODE=off
BARI_DEV_PHONE_OTP=
BARI_DEV_PHONE_AUTH_SECRET=
BARI_DEV_SUPABASE_SERVICE_ROLE_KEY=

# অনলাইনে সরাসরি জানানো কোড দিয়ে প্রবেশ। এগুলো Vercel Production-এর server-only মান।
# BARI_PHONE_AUTH_MODE=manual দিন; নিচের গোপন মানের সামনে VITE_ বসাবেন না।
BARI_MANUAL_PHONE_CODE=
BARI_PHONE_AUTH_SECRET=
BARI_SUPABASE_SERVICE_ROLE_KEY=
BARI_PUBLIC_APP_ORIGIN=https://bari-khata.vercel.app
