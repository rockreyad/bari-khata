# শুধু VITE_ মান ব্রাউজারে যায়। গোপন কী বা OTP-এর নামে কখনও VITE_ যোগ করবেন না।
VITE_SUPABASE_URL=http://127.0.0.1:55431
VITE_SUPABASE_ANON_KEY=

# সার্ভারের স্থানীয় ফোন লগইন: off | mock | sms। নির্দিষ্ট পরীক্ষার কোড শুধু localhost-এ চলে।
BARI_PHONE_AUTH_MODE=off
BARI_DEV_PHONE_OTP=
BARI_DEV_PHONE_AUTH_SECRET=
BARI_DEV_SUPABASE_SERVICE_ROLE_KEY=
